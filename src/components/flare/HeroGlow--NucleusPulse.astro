---
/**
 * HeroGlow--NucleusPulse
 *
 * A simple pulsing radial glow effect, centered behind content.
 * Extracted from the "Orbital Cosmos" hero section (WhyNowWhyUs-v4).
 *
 * Features:
 * - Radial gradient from color to transparent
 * - Heavy blur for soft glow
 * - Pulsing scale animation
 * - Perfect for centering behind headlines or focal points
 */

interface Props {
  /** Container size - can be any CSS value */
  size?: string;
  /** Container height - if different from size */
  height?: string;
  /** Enable animations */
  animate?: boolean;
  /** Animation speed multiplier (1 = normal) */
  animationSpeed?: number;
  /** Glow color */
  color?: string;
  /** Size of the glow circle (CSS value) */
  glowSize?: string;
  /** Blur amount in pixels */
  blur?: number;
  /** Base opacity (0-1) */
  opacity?: number;
  /** Additional CSS classes */
  class?: string;
}

const {
  size = '100%',
  height,
  animate = true,
  animationSpeed = 1,
  color = '#6643e2',
  glowSize = '300px',
  blur = 60,
  opacity = 0.6,
  class: className = '',
} = Astro.props;

const containerId = `nucleus-pulse-${Math.random().toString(36).slice(2, 9)}`;
const containerHeight = height || size;
---

<div
  id={containerId}
  class:list={['nucleus-pulse-container', className]}
  style={`
    width: ${size};
    height: ${containerHeight};
    --glow-color: ${color};
    --glow-size: ${glowSize};
    --glow-blur: ${blur}px;
    --glow-opacity: ${opacity};
    --animation-speed: ${animationSpeed};
  `}
  data-animate={animate}
>
  <!-- The pulsing glow -->
  <div class="nucleus-glow"></div>

  <!-- Content slot -->
  <div class="nucleus-content">
    <slot />
  </div>
</div>

<style>
  .nucleus-pulse-container {
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .nucleus-glow {
    position: absolute;
    width: var(--glow-size);
    height: var(--glow-size);
    background: radial-gradient(
      circle at center,
      var(--glow-color) 0%,
      color-mix(in srgb, var(--glow-color) 60%, transparent) 30%,
      color-mix(in srgb, var(--glow-color) 20%, transparent) 50%,
      transparent 70%
    );
    filter: blur(var(--glow-blur));
    opacity: var(--glow-opacity);
    pointer-events: none;
  }

  /* Animation */
  [data-animate="true"] .nucleus-glow {
    animation: glow-pulse calc(4s / var(--animation-speed)) ease-in-out infinite;
  }

  @keyframes glow-pulse {
    0%, 100% {
      transform: scale(1);
      opacity: var(--glow-opacity);
    }
    50% {
      transform: scale(1.2);
      opacity: calc(var(--glow-opacity) * 1.3);
    }
  }

  /* Content overlay */
  .nucleus-content {
    position: relative;
    z-index: 1;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .nucleus-glow {
      animation: none !important;
    }
  }
</style>
